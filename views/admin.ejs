<%- include('partials/header', { title: 'Admin', active: 'admin' }) %>

<div class="page-head">
  <div>
    <h1>Admin</h1>
    <p class="sub">Create accounts, manage access, and see who's using the system.</p>
  </div>
</div>

<div class="stat-strip">
  <div class="stat-pill"><strong><%= onlineCount %></strong>Online now (last <%= onlineWindowMinutes %> min)</div>
  <div class="stat-pill"><strong><%= users.length %></strong>Total accounts</div>
</div>

<div class="table-card">
  <h2 class="card-title">Accounts</h2>
  <table>
    <thead>
      <tr>
        <th>Full name</th><th>Username</th><th>Unit</th><th>Role</th><th>Privilege</th>
        <th>Online</th><th>Logins</th><th>Uploads</th><th>Reports</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td>
            <a href="/admin/users/<%= u.id %>/profile"><%= u.full_name %></a>
          </td>
          <td><%= u.username %></td>
          <td><%= u.unit || '—' %></td>
          <td><span class="role-pill role-<%= u.role %>"><%= u.role %></span></td>
          <td>
            <form action="/admin/users/<%= u.id %>/privilege" method="POST" class="toggle-form">
              <select name="privilege" class="privilege-select" onChange="this.form.submit()">
                <option value="normal" <%= u.privilege === 'normal' ? 'selected' : '' %>>Normal (own unit)</option>
                <option value="administration" <%= u.privilege === 'administration' ? 'selected' : '' %>>Administration (all units)</option>
                <option value="super" <%= u.privilege === 'super' ? 'selected' : '' %>>Super (everything)</option>
              </select>
            </form>
          </td>
          <td>
            <span class="online-pill <%= u.online ? 'is-online' : '' %>">
              <span class="online-dot"></span><%= u.online ? 'Online' : 'Offline' %>
            </span>
          </td>
          <td>
            <span class="login-freq">
              <strong><%= u.login_count %></strong> total
              <% if (u.last_login_at) { %><br><span class="hint"><%= new Date(u.last_login_at).toLocaleString() %></span><% } %>
            </span>
          </td>
          <td>
            <form action="/admin/users/<%= u.id %>/toggle-upload" method="POST" class="toggle-form">
              <label class="switch">
                <input type="checkbox" name="can_upload" value="on" <%= u.can_upload ? 'checked' : '' %> onChange="this.form.submit()">
                <span class="slider"></span>
              </label>
            </form>
          </td>
          <td>
            <form action="/admin/users/<%= u.id %>/toggle-download-reports" method="POST" class="toggle-form">
              <label class="switch">
                <input type="checkbox" name="can_download_reports" value="on" <%= u.can_download_reports ? 'checked' : '' %> onChange="this.form.submit()">
                <span class="slider"></span>
              </label>
            </form>
          </td>
          <td>
            <div class="row-actions">
              <a href="/admin/users/<%= u.id %>/edit" class="link-btn">Edit</a>
              <form action="/admin/users/<%= u.id %>/reset-password" method="POST" onsubmit="return confirm('Reset this account password?');">
                <input type="password" name="password" placeholder="New password" required>
                <button type="submit" class="link-btn">Reset</button>
              </form>
              <% if (u.id !== currentUser.id) { %>
                <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Remove this account?');">
                  <button type="submit" class="link-btn danger">Remove</button>
                </form>
              <% } else { %>
                <span class="hint">You</span>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="table-card" style="margin-top:20px; max-width:520px;">
  <h2 class="card-title">New account</h2>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <form action="/admin/users" method="POST" class="stack">
    <div class="field-row">
      <div class="field">
        <label>Full name</label>
        <input type="text" name="full_name" required>
      </div>
      <div class="field">
        <label>Username</label>
        <input type="text" name="username" required>
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label>Temporary password</label>
        <input type="text" name="password" required>
      </div>
      <div class="field">
        <label>Email</label>
        <input type="email" name="email">
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label>Mobile number</label>
        <input type="text" name="mobile_number">
      </div>
      <div class="field">
        <label>Highest level of education</label>
        <input type="text" name="education_level" placeholder="e.g. Bachelor's degree">
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label>Unit</label>
        <select name="unit">
          <option value="">Select unit</option>
          <% units.forEach((u) => { %><option value="<%= u %>"><%= u %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label>Account role</label>
        <select name="role">
          <option value="officer">Officer</option>
          <option value="admin">Admin</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label>Report visibility privilege</label>
      <select name="privilege">
        <option value="normal">Normal — own unit only</option>
        <option value="administration">Administration — all units</option>
        <option value="super">Super — everything</option>
      </select>
      <p class="hint">Account role controls Admin panel access. Privilege controls which units' activities and reports this account can see.</p>
    </div>
    <button type="submit" class="btn-primary full">Create account</button>
  </form>
</div>

<div class="table-card danger-zone">
  <h2 class="card-title">Danger zone</h2>
  <p class="hint">Permanently remove every activity logged in the system, including their attachments. This cannot be undone.</p>
  <form action="/admin/activities/clear" method="POST" onsubmit="return confirm('Delete ALL activities for every officer? This cannot be undone.');">
    <button type="submit" class="link-btn danger">Delete all activities</button>
  </form>
</div>

<%- include('partials/footer') %>
