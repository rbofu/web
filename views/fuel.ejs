<%- include('partials/header', { title: 'Fuel & Fleet', active: 'fuel' }) %>

<div class="page-head">
  <div>
    <h1>Fuel &amp; Fleet Monitoring</h1>
    <p class="sub">Track vehicle documents and log every day of travel — distance and fuel use are calculated automatically (1 litre per 6 km).</p>
  </div>
  <div class="row-actions">
    <button class="btn-ghost" id="newVehicleBtn">＋ Add vehicle</button>
    <button class="btn-primary" id="newLogBtn">＋ Log a day's travel</button>
  </div>
</div>

<div id="fleetAlertBanner" class="conflict-banner" hidden></div>

<div class="stat-strip" id="fuelStatStrip"></div>

<div class="tab-row">
  <button type="button" class="tab-btn active" data-tab="fleet">Vehicle Fleet</button>
  <button type="button" class="tab-btn" data-tab="logs">Fuel Logs</button>
</div>

<div class="tab-panel" id="fleetTab">
  <div class="fleet-grid" id="fleetGrid"></div>
  <p class="empty-state" id="fleetEmpty" hidden>No vehicles registered yet. Add one to start tracking fuel by vehicle.</p>
</div>

<div class="tab-panel" id="logsTab" hidden>
  <div class="page-head" style="margin-bottom:12px;">
    <p class="sub" style="margin:0;">Distance = Ending − Starting kilometer. Fuel (litres) = Distance ÷ 6. Entries with the same Task name are grouped and totalled.</p>
  </div>
  <div id="tableWrap"><p class="empty-state">Loading…</p></div>
</div>

<!-- Vehicle modal -->
<div class="overlay" id="vehicleOverlay">
  <div class="modal">
    <button class="close-x" id="vehicleCloseX">✕</button>
    <h3>Add vehicle</h3>
    <div class="err" id="vehicleErr" hidden></div>
    <form id="vehicleForm" class="stack">
      <div class="two-col">
        <div class="field">
          <label>Plate number</label>
          <input type="text" id="vPlate" required placeholder="e.g. T 123 ABC">
        </div>
        <div class="field">
          <label>Make / model</label>
          <input type="text" id="vMakeModel" required placeholder="e.g. Toyota Land Cruiser">
        </div>
      </div>
      <div class="two-col">
        <div class="field">
          <label>Assigned driver</label>
          <input type="text" id="vDriver" placeholder="e.g. John Mushi">
        </div>
        <div class="field">
          <label>Section / Unit</label>
          <select id="vUnit">
            <option value="">— None —</option>
            <% units.forEach(function(u){ %><option value="<%= u %>"><%= u %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="two-col">
        <div class="field">
          <label>Status</label>
          <select id="vStatus">
            <option value="active">Active</option>
            <option value="maintenance">In maintenance</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
        <div class="field">
          <label>Current odometer (km)</label>
          <input type="number" id="vOdometer" min="0" step="0.1" placeholder="e.g. 45210">
        </div>
      </div>
      <div class="two-col">
        <div class="field">
          <label>Insurance expiry</label>
          <input type="date" id="vInsurance">
        </div>
        <div class="field">
          <label>Inspection expiry</label>
          <input type="date" id="vInspection">
        </div>
      </div>
      <div class="field">
        <label>Next service due (km)</label>
        <input type="number" id="vServiceDue" min="0" step="1" placeholder="e.g. 50000">
      </div>
      <div class="field">
        <label>Notes (optional)</label>
        <textarea id="vNotes"></textarea>
      </div>
      <input type="hidden" id="vId">
      <div class="modal-actions">
        <button type="button" class="btn-ghost" id="vehicleCancelBtn">Cancel</button>
        <button type="submit" class="btn-primary">Save vehicle</button>
      </div>
    </form>
  </div>
</div>

<!-- Fuel log modal -->
<div class="overlay" id="logOverlay">
  <div class="modal">
    <button class="close-x" id="logCloseX">✕</button>
    <h3>Log a day's travel</h3>
    <div class="err" id="logErr" hidden></div>
    <form id="logForm" class="stack">
      <div class="two-col">
        <div class="field">
          <label>Task / Assignment</label>
          <input type="text" id="lTask" required placeholder="e.g. Mara Region MDA Supervision">
        </div>
        <div class="field">
          <label>Name of Section</label>
          <input type="text" id="lSection" placeholder="e.g. MDA & Logistics Unit">
        </div>
      </div>
      <div class="two-col">
        <div class="field">
          <label>Vehicle</label>
          <select id="lVehicle">
            <option value="">— Not tracked —</option>
          </select>
        </div>
        <div class="field">
          <label>Name of driver</label>
          <input type="text" id="lDriver" required placeholder="e.g. John Mushi">
        </div>
      </div>
      <div class="two-col">
        <div class="field">
          <label>Date</label>
          <input type="date" id="lDate" required>
        </div>
        <div class="field">
          <label>Place(s) visited</label>
          <input type="text" id="lPlaces" placeholder="e.g. Musoma, Bunda, Serengeti">
        </div>
      </div>
      <div class="two-col">
        <div class="field">
          <label>Starting kilometer</label>
          <input type="number" id="lStartKm" min="0" step="0.1" required placeholder="e.g. 45210">
        </div>
        <div class="field">
          <label>Journey started at</label>
          <input type="text" id="lStartPlace" placeholder="e.g. Programme HQ, Arusha">
        </div>
      </div>
      <div class="two-col">
        <div class="field">
          <label>Ending kilometer</label>
          <input type="number" id="lEndKm" min="0" step="0.1" required placeholder="e.g. 45480">
        </div>
        <div class="field">
          <label>Journey ended at</label>
          <input type="text" id="lEndPlace" placeholder="e.g. Musoma District Office">
        </div>
      </div>
      <div class="preview-box" id="logPreview">Enter the starting and ending kilometers to see the distance and fuel used.</div>
      <div class="modal-actions">
        <button type="button" class="btn-ghost" id="logCancelBtn">Cancel</button>
        <button type="submit" class="btn-primary">Save log</button>
      </div>
    </form>
  </div>
</div>

<script>
  window.currentUser = <%- JSON.stringify(user || null) %>;
</script>
<script src="/js/fuel.js"></script>
<%- include('partials/footer') %>
