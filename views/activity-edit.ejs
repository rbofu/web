<%- include('partials/header', { title: 'Edit Activity', active: 'activities' }) %>

<div class="page-head">
  <div>
    <h1>Edit Activity</h1>
    <p class="sub">Update details for this activity entry and add staff reports.</p>
  </div>
  <%- include('partials/status-badge', { status: activityStatus }) %>
</div>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>
<% if (success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<div class="tab-row">
  <button type="button" class="tab-btn <%= activeTab === 'details' ? 'active' : '' %>" data-tab="details">Details</button>
  <button type="button" class="tab-btn <%= activeTab === 'report' ? 'active' : '' %>" data-tab="report">Report</button>
</div>

<div class="tab-panel" id="detailsTab" <%= activeTab !== 'details' ? 'hidden' : '' %>>
  <% if (canEdit) { %>
    <form action="/activities/<%= activity.id %>/edit" method="POST" class="stack">
      <div class="field">
        <label>Activity name</label>
        <input type="text" name="name" value="<%= activity.name %>" required>
      </div>

      <div class="two-col">
        <div class="field">
          <label>Start date</label>
          <input type="date" name="start_date" value="<%= activity.start_date %>" required>
        </div>
        <div class="field">
          <label>End date</label>
          <input type="date" name="end_date" value="<%= activity.end_date %>" required>
        </div>
      </div>

      <div class="field">
        <label>Location</label>
        <input type="text" name="location" value="<%= activity.location %>">
      </div>

      <div class="field">
        <label>Participants</label>
        <input type="text" name="participants" value="<%= participants.join(', ') %>" placeholder="Separate names with commas">
        <p class="hint">Enter participant names separated by commas.</p>
      </div>

      <div class="field">
        <label>Notes</label>
        <textarea name="notes"><%= activity.notes %></textarea>
      </div>

      <div class="field">
        <label>Attachments</label>
        <% if (attachments.length) { %>
          <ul class="attachment-list">
            <% attachments.forEach((attachment) => { %>
              <li><a href="/api/activities/<%= activity.id %>/attachments/<%= attachment.id %>"><%= attachment.original_name %></a></li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="sub">No attachments uploaded for this activity.</p>
        <% } %>
      </div>

      <div class="form-actions">
        <a href="/activities" class="btn-ghost">Back</a>
        <button type="submit" class="btn-primary">Save changes</button>
      </div>
    </form>
  <% } else { %>
    <div class="stack">
      <div class="field">
        <label>Activity name</label>
        <div class="readonly"><%= activity.name %></div>
      </div>
      <div class="two-col">
        <div class="field">
          <label>Start date</label>
          <div class="readonly"><%= activity.start_date %></div>
        </div>
        <div class="field">
          <label>End date</label>
          <div class="readonly"><%= activity.end_date %></div>
        </div>
      </div>
      <div class="field">
        <label>Location</label>
        <div class="readonly"><%= activity.location || '—' %></div>
      </div>
      <div class="field">
        <label>Participants</label>
        <div class="readonly"><%= participants.join(', ') || '—' %></div>
      </div>
      <div class="field">
        <label>Notes</label>
        <div class="readonly"><%= activity.notes || '—' %></div>
      </div>
      <div class="field">
        <label>Attachments</label>
        <% if (attachments.length) { %>
          <ul class="attachment-list">
            <% attachments.forEach((attachment) => { %>
              <li><a href="/api/activities/<%= activity.id %>/attachments/<%= attachment.id %>"><%= attachment.original_name %></a></li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="sub">No attachments uploaded for this activity.</p>
        <% } %>
      </div>
      <a href="/activities" class="btn-ghost">Back to activities</a>
    </div>
  <% } %>
</div>

<div class="tab-panel" id="reportTab" <%= activeTab !== 'report' ? 'hidden' : '' %>>
  <div class="stack">
    <form action="/activities/<%= activity.id %>/report" method="POST" enctype="multipart/form-data" class="stack">
      <div class="field">
        <label>Report summary</label>
        <textarea name="report_text" required></textarea>
      </div>
      <div class="field">
        <label>Unit</label>
        <select name="unit">
          <option value="">Select unit</option>
          <% units.forEach((u) => { %>
            <option value="<%= u %>" <%= (reports[0] && reports[0].unit === u) || (user && user.unit === u) ? 'selected' : '' %>><%= u %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label>Attach files</label>
        <input type="file" name="report_attachments" multiple accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.ppt,.pptx">
        <p class="hint">Upload supplemental report files. PDF, image, or MS Office formats are accepted.</p>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-primary">Submit report</button>
      </div>
    </form>

    <div class="field">
      <h2 class="card-title">Submitted reports</h2>
      <% if (reports && reports.length) { %>
        <% reports.forEach((report) => { %>
          <div class="report-card">
            <div class="report-meta">
              <strong><%= report.created_by_name %></strong>
              <span>• <%= new Date(report.created_at).toLocaleString() %></span>
              <% if (report.unit) { %><span>• <%= report.unit %></span><% } %>
              <% if (user && (user.role === 'admin' || user.id === report.created_by || user.can_download_reports)) { %>
                <a href="/api/activities/<%= activity.id %>/reports/<%= report.id %>/download" class="link-btn">Download report</a>
              <% } %>
            </div>
            <div class="report-text"><%= report.report_text %></div>
            <% if (report.attachments.length) { %>
              <div class="field">
                <label>Attachments</label>
                <ul class="attachment-list">
                  <% report.attachments.forEach((attachment) => { %>
                    <li><a href="/api/activities/<%= activity.id %>/reports/<%= report.id %>/attachments/<%= attachment.id %>"><%= attachment.original_name %></a></li>
                  <% }) %>
                </ul>
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } else { %>
        <p class="sub">No reports have been submitted for this activity yet.</p>
      <% } %>
    </div>

  </div>
</div>

<script>
  document.querySelectorAll('.tab-btn').forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach((btn) => btn.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach((panel) => panel.hidden = true);
      button.classList.add('active');
      document.getElementById(button.dataset.tab + 'Tab').hidden = false;
    });
  });
</script>
<%- include('partials/footer') %>
