<%- include('partials/header', { title: 'Edit User', active: 'admin' }) %>

<div class="page-head">
  <div>
    <h1>Edit account</h1>
    <p class="sub">Update user details, role, privilege, or password for this officer.</p>
  </div>
</div>

<div class="layout">
  <div class="agenda">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <form action="/admin/users/<%= editUser.id %>/update" method="POST" class="stack">
      <div class="field">
        <label>Full name</label>
        <input type="text" name="full_name" value="<%= editUser.full_name %>" required>
      </div>
      <div class="field">
        <label>Username</label>
        <input type="text" name="username" value="<%= editUser.username %>" required>
      </div>
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" value="<%= editUser.email || '' %>">
      </div>
      <div class="field">
        <label>Mobile number</label>
        <input type="text" name="mobile_number" value="<%= editUser.mobile_number || '' %>">
      </div>
      <div class="field">
        <label>Highest level of education</label>
        <input type="text" name="education_level" value="<%= editUser.education_level || '' %>">
      </div>
      <div class="field">
        <label>Unit</label>
        <select name="unit">
          <option value="">Select unit</option>
          <% units.forEach((u) => { %>
            <option value="<%= u %>" <%= editUser.unit === u ? 'selected' : '' %>><%= u %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label>Account role</label>
        <select name="role">
          <option value="officer" <%= editUser.role === 'officer' ? 'selected' : '' %>>Officer</option>
          <option value="admin" <%= editUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
        </select>
        <p class="hint">Controls access to the Admin panel (account management).</p>
      </div>
      <div class="field">
        <label>Report visibility privilege</label>
        <select name="privilege">
          <option value="normal" <%= editUser.privilege === 'normal' ? 'selected' : '' %>>Normal — own unit only</option>
          <option value="administration" <%= editUser.privilege === 'administration' ? 'selected' : '' %>>Administration — all units</option>
          <option value="super" <%= editUser.privilege === 'super' ? 'selected' : '' %>>Super — everything</option>
        </select>
        <p class="hint">Controls which units' activities and reports this account can see.</p>
      </div>
      <div class="field">
        <label>Upload access</label>
        <label class="switch-field">
          <input type="checkbox" name="can_upload" <%= editUser.can_upload ? 'checked' : '' %>>
          <span>Allow this user to upload files</span>
        </label>
      </div>
      <div class="field">
        <label>Report download access</label>
        <label class="switch-field">
          <input type="checkbox" name="can_download_reports" <%= editUser.can_download_reports ? 'checked' : '' %>>
          <span>Allow this user to download submitted reports</span>
        </label>
      </div>
      <div class="field">
        <label>New password</label>
        <input type="password" name="password" placeholder="Leave blank to keep current password">
      </div>
      <button type="submit" class="btn-primary full">Save changes</button>
    </form>
    <p class="hint"><a href="/admin">Back to admin panel</a></p>
  </div>
</div>

<%- include('partials/footer') %>
